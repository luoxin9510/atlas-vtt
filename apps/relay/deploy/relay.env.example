# /etc/atlas-relay.env (mode 0600, owner root). Copy from apps/relay/deploy/relay.env.example.
# Generate the host key with: openssl rand -base64 32
HOST_KEY=
PUBLIC_ORIGIN=https://play.example.com
HOST=127.0.0.1
PORT=8787
TRUST_PROXY=cf
STATE_PATH=/var/lib/atlas-relay/relay-state.json
ASSET_DIR=/var/lib/atlas-relay/assets
STATIC_DIR=apps/play/dist
